+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {DatabaseSync} from 'node:sqlite';
+import worker from '../../shared-backend/worker/src/index.js';
+import {compareWorkState} from '../../shared-backend/work-parity-core.mjs';
+
+// Private input stays outside Git. This harness never connects to remote D1.
+const source=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));
+const sqlFiles=fs.readdirSync('drizzle').filter(x=>x.endsWith('.sql')).sort();
+function database(){
+  const sqlite=new DatabaseSync(':memory:');
+  for(const file of sqlFiles)sqlite.exec(fs.readFileSync('drizzle/'+file,'utf8'));
+  for(const id of new Set(source.taskPeople.map(x=>x.profileId)))sqlite.prepare('INSERT INTO profiles (id,name,created_at,updated_at) VALUES (?,?,?,?)').run(id,id,'sentinel','sentinel');
+  const execute=(sql,params,mode)=>{
+    const st=sqlite.prepare(sql);
+    if(mode==='first')return st.get(...params)||null;
+    if(mode==='all')return {results:st.all(...params)};
+    return st.run(...params);
+  };
+  const DB={
+    prepare(sql){const statement={sql,params:[],bind(...params){return {...statement,params,first:()=>Promise.resolve(execute(sql,params,'first')),all:()=>Promise.resolve(execute(sql,params,'all')),run:()=>Promise.resolve(execute(sql,params,'run'))};},first:()=>Promise.resolve(execute(sql,[],'first')),all:()=>Promise.resolve(execute(sql,[],'all')),run:()=>Promise.resolve(execute(sql,[],'run'))};return statement;},
+    async batch(statements){sqlite.exec('BEGIN');try{const results=statements.map(s=>execute(s.sql,s.params,'run'));sqlite.exec('COMMIT');return results;}catch(e){sqlite.exec('ROLLBACK');throw e;}}
+  };
+  return {sqlite,DB};
+}
+const envToken='isolated-test-token';
+async function call(env,path,method='GET',body=null,token=envToken){
+  const res=await worker.fetch(new Request('https://isolated.invalid'+path,{method,headers:{authorization:'Bearer '+token,'content-type':'application/json'},...(body?{body:JSON.stringify(body)}:{})}),{...env,WORK_API_TOKEN:envToken});
+  return {status:res.status,body:await res.json()};
+}
+const {sqlite,DB}=database();
+const untouched=()=>JSON.stringify(sqlite.prepare("SELECT name,sql FROM sqlite_schema WHERE type='table' AND name NOT LIKE 'work_%' ORDER BY name").all().map(t=>[t,sqlite.prepare('SELECT * FROM "'+t.name+'"').all()]));
+const before=untouched();
+assert.equal((await call({DB},'/v1/work/state','GET',null,'wrong-token')).status,401);
+const staged=await call({DB},'/v1/work/migrations/stage','POST',source);
+assert.equal(staged.status,201);assert.equal(staged.body.stage,'staged-not-active');
+const exported=(await call({DB},'/v1/work/state')).body;
+assert.equal(compareWorkState(source,exported).summary.pass,true);
+const verified=await call({DB},'/v1/work/migrations/'+source.batchId+'/verify','POST',source);
+assert.equal(verified.status,200);assert.equal(verified.body.stage,'verified-not-active');assert.equal(verified.body.historyMatches,true);
+assert.equal(sqlite.prepare('SELECT COUNT(*) AS n FROM work_changes').get().n,source.tasks.length+source.hubs.length+source.projects.length);
+assert.equal((await call({DB},'/v1/work/migrations/stage','POST',source)).status,200);
+assert.equal(sqlite.prepare('SELECT COUNT(*) AS n FROM work_changes').get().n,source.tasks.length+source.hubs.length+source.projects.length);
+assert.equal((await call({DB},'/v1/work/migrations/'+source.batchId+'/activate','POST',source)).status,404);
+assert.equal(untouched(),before);
+
+const mutations=[
+  x=>x.tasks[0].status='Backlog',x=>x.tasks[0].notes+='changed',x=>x.tasks[0].revision++,
+  x=>x.taskPeople.pop(),x=>x.dependencies.pop(),x=>x.sourceAliases.pop(),
+  x=>x.sourceAliases[0].source_status='changed',x=>x.projects[0].title+='changed',
+  x=>x.hubs[0].summary+='changed',x=>x.resources[0].url+='changed',
+  x=>x.tasks.push({...x.tasks[0]}),x=>x.tasks[0].parent_task_id=x.tasks[0].id,
+];
+for(const mutate of mutations){const changed=structuredClone(exported);mutate(changed);assert.equal(compareWorkState(source,changed).summary.pass,false);}
+sqlite.prepare("UPDATE work_tasks SET notes='corrupted' WHERE id=?").run(source.tasks[0].id);
+sqlite.prepare("UPDATE work_migration_batches SET status='staged' WHERE batch_id=?").run(source.batchId);
+assert.equal((await call({DB},'/v1/work/migrations/'+source.batchId+'/verify','POST',source)).status,409);
+assert.equal(sqlite.prepare('SELECT status FROM work_migration_batches').get().status,'staged');
+
+const blank=database();
+const bad=structuredClone(source);bad.taskPeople[0].profileId='unrecognized-profile';
+assert.equal((await call(blank,'/v1/work/migrations/stage','POST',bad)).status,500);
+assert.equal(blank.sqlite.prepare('SELECT COUNT(*) AS n FROM work_tasks').get().n,0);
+const corrupt=structuredClone(source);corrupt.checksum='wrong';
+assert.equal((await call(blank,'/v1/work/migrations/stage','POST',corrupt)).status,500);
+assert.equal(blank.sqlite.prepare('SELECT COUNT(*) AS n FROM work_migration_batches').get().n,0);
+const cycle=structuredClone(source);cycle.dependencies=[{taskId:source.tasks[0].id,dependsOnTaskId:source.tasks[1].id},{taskId:source.tasks[1].id,dependsOnTaskId:source.tasks[0].id}];
+assert.equal(compareWorkState(cycle,cycle).summary.pass,false);
+
+const aliases=new Map(source.sourceAliases.map(x=>[x.sourceName+':'+x.sourceRecordId,x.canonicalTaskId]));
+assert.notEqual(aliases.get('google-sheet:T-023'),aliases.get('task-manager:T-023'));
+assert.equal(aliases.get('google-sheet:T-023'),aliases.get('task-manager:A-035'));
+console.log(JSON.stringify({pass:true,isolatedSqlite:true,canonicalTasks:source.tasks.length,peopleLinks:source.taskPeople.length,dependencies:source.dependencies.length,aliases:source.sourceAliases.length,historyRows:source.tasks.length+source.hubs.length+source.projects.length,negativeParityChecks:mutations.length,legacyCollisionPreserved:true,existingTablesUnchanged:true,activationUnavailable:true}));
