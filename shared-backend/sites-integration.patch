diff --git a/db/work-schema.ts b/db/work-schema.ts
new file mode 100644
index 0000000..0df180e
--- /dev/null
+++ b/db/work-schema.ts
@@ -0,0 +1,199 @@
+// Additive Phase 1 Work schema. Existing Network HQ tables stay unchanged.
+import { sql } from "drizzle-orm";
+import { sqliteTable,text,integer,index,uniqueIndex,primaryKey,check,type AnySQLiteColumn } from "drizzle-orm/sqlite-core";
+
+export const work_schema_meta = sqliteTable("work_schema_meta", {
+  key: text("key").primaryKey(),
+  value: text("value").notNull(),
+  updatedAt: text("updated_at").notNull(),
+});
+
+export const work_migration_batches = sqliteTable("work_migration_batches", {
+  batchId: text("batch_id").primaryKey(),
+  sourceName: text("source_name").notNull(),
+  sourceRevision: text("source_revision"),
+  status: text("status").notNull().default("staged"),
+  expectedTaskCount: integer("expected_task_count"),
+  importedTaskCount: integer("imported_task_count").notNull().default(0),
+  checksum: text("checksum"),
+  notes: text("notes"),
+  createdAt: text("created_at").notNull(),
+  verifiedAt: text("verified_at"),
+  activatedAt: text("activated_at"),
+  rolledBackAt: text("rolled_back_at"),
+}, (t) => [
+  check("work_migration_batches_check_0", sql`status IN ('staged','verified','active','failed','rolled_back')`)
+]);
+
+export const work_hubs = sqliteTable("work_hubs", {
+  id: text("id").primaryKey(),
+  title: text("title").notNull(),
+  summary: text("summary").notNull().default(""),
+  color: text("color").notNull().default(""),
+  priority: integer("priority").notNull().default(50),
+  archived: integer("archived").notNull().default(0),
+  revision: integer("revision").notNull().default(1),
+  createdAt: text("created_at").notNull(),
+  updatedAt: text("updated_at").notNull(),
+  archivedAt: text("archived_at"),
+}, (t) => [
+  check("work_hubs_check_0", sql`archived IN (0,1)`)
+]);
+
+export const work_projects = sqliteTable("work_projects", {
+  id: text("id").primaryKey(),
+  hubId: text("hub_id").notNull().references((): AnySQLiteColumn => work_hubs.id, {"onUpdate": "cascade", "onDelete": "restrict"}),
+  title: text("title").notNull(),
+  summary: text("summary").notNull().default(""),
+  area: text("area").notNull().default(""),
+  goalId: text("goal_id"),
+  parentProjectId: text("parent_project_id").references((): AnySQLiteColumn => work_projects.id, {"onUpdate": "cascade", "onDelete": "set null"}),
+  color: text("color").notNull().default(""),
+  priority: integer("priority").notNull().default(50),
+  archived: integer("archived").notNull().default(0),
+  revision: integer("revision").notNull().default(1),
+  createdAt: text("created_at").notNull(),
+  updatedAt: text("updated_at").notNull(),
+  archivedAt: text("archived_at"),
+}, (t) => [
+  check("work_projects_check_0", sql`archived IN (0,1)`)
+]);
+
+export const work_tasks = sqliteTable("work_tasks", {
+  id: text("id").primaryKey(),
+  displayId: text("display_id"),
+  hubId: text("hub_id").notNull().references((): AnySQLiteColumn => work_hubs.id, {"onUpdate": "cascade", "onDelete": "restrict"}),
+  projectId: text("project_id").notNull().references((): AnySQLiteColumn => work_projects.id, {"onUpdate": "cascade", "onDelete": "restrict"}),
+  parentTaskId: text("parent_task_id").references((): AnySQLiteColumn => work_tasks.id, {"onUpdate": "cascade", "onDelete": "set null"}),
+  title: text("title").notNull(),
+  designation: text("designation").notNull().default("major"),
+  status: text("status").notNull().default("Open"),
+  priority: integer("priority").notNull().default(2),
+  area: text("area").notNull().default(""),
+  goalId: text("goal_id"),
+  milestoneId: text("milestone_id"),
+  microDone: integer("micro_done").notNull().default(0),
+  classificationStatus: text("classification_status").notNull().default("verified"),
+  classificationConfidence: text("classification_confidence"),
+  proposedDesignation: text("proposed_designation"),
+  proposedParentTaskId: text("proposed_parent_task_id").references((): AnySQLiteColumn => work_tasks.id, {"onUpdate": "cascade", "onDelete": "set null"}),
+  flowPhase: text("flow_phase").notNull().default("later"),
+  flowOrder: integer("flow_order").notNull().default(999),
+  durationEstimate: text("duration_estimate").notNull().default(""),
+  timingType: text("timing_type").notNull().default("flexible"),
+  earliestStart: text("earliest_start").notNull().default(""),
+  targetDate: text("target_date").notNull().default(""),
+  dueText: text("due_text").notNull().default(""),
+  dueDate: text("due_date"),
+  timingNote: text("timing_note").notNull().default(""),
+  nextAction: text("next_action").notNull().default(""),
+  waitingOn: text("waiting_on").notNull().default(""),
+  notes: text("notes").notNull().default(""),
+  source: text("source").notNull().default("shared-work-backend"),
+  todayRank: integer("today_rank"),
+  effort: text("effort").notNull().default(""),
+  revision: integer("revision").notNull().default(1),
+  lastChangeSource: text("last_change_source").notNull().default("migration"),
+  migrationBatchId: text("migration_batch_id").references((): AnySQLiteColumn => work_migration_batches.batchId, {"onUpdate": "cascade", "onDelete": "set null"}),
+  createdAt: text("created_at").notNull(),
+  updatedAt: text("updated_at").notNull(),
+  completedAt: text("completed_at"),
+  archivedAt: text("archived_at"),
+}, (t) => [
+  check("work_tasks_check_0", sql`designation IN ('major','micro','outcome')`),
+  check("work_tasks_check_1", sql`status IN ('Open','In Progress','Waiting','Backlog','Done','Archived')`),
+  check("work_tasks_check_2", sql`priority BETWEEN 1 AND 3`),
+  check("work_tasks_check_3", sql`micro_done IN (0,1)`),
+  check("work_tasks_check_4", sql`flow_phase IN ('now','next','later','waiting')`),
+  check("work_tasks_check_5", sql`timing_type IN ('hard','target','dependency','flexible')`),
+  check("work_tasks_check_6", sql`parent_task_id IS NULL OR parent_task_id <> id`),
+  uniqueIndex("idx_work_tasks_display_id").on(t.displayId).where(sql`display_id IS NOT NULL AND display_id <> ''`),
+  index("idx_work_tasks_project").on(t.projectId),
+  index("idx_work_tasks_hub").on(t.hubId),
+  index("idx_work_tasks_parent").on(t.parentTaskId),
+  index("idx_work_tasks_status").on(t.status),
+  index("idx_work_tasks_flow").on(t.projectId,t.flowPhase,t.flowOrder)
+]);
+
+export const work_task_people = sqliteTable("work_task_people", {
+  taskId: text("task_id").notNull().references((): AnySQLiteColumn => work_tasks.id, {"onUpdate": "cascade", "onDelete": "cascade"}),
+  profileId: text("profile_id").notNull(),
+  role: text("role").notNull().default(""),
+  createdAt: text("created_at").notNull(),
+}, (t) => [
+  primaryKey({columns:[t.taskId,t.profileId]}),
+  index("idx_work_task_people_profile").on(t.profileId)
+]);
+
+export const work_task_dependencies = sqliteTable("work_task_dependencies", {
+  taskId: text("task_id").notNull().references((): AnySQLiteColumn => work_tasks.id, {"onUpdate": "cascade", "onDelete": "cascade"}),
+  dependsOnTaskId: text("depends_on_task_id").notNull().references((): AnySQLiteColumn => work_tasks.id, {"onUpdate": "cascade", "onDelete": "cascade"}),
+  dependencyType: text("dependency_type").notNull().default("finish_to_start"),
+  createdAt: text("created_at").notNull(),
+}, (t) => [
+  primaryKey({columns:[t.taskId,t.dependsOnTaskId]}),
+  check("work_task_dependencies_check_0", sql`task_id <> depends_on_task_id`)
+]);
+
+export const work_task_resources = sqliteTable("work_task_resources", {
+  id: text("id").primaryKey(),
+  taskId: text("task_id").notNull().references((): AnySQLiteColumn => work_tasks.id, {"onUpdate": "cascade", "onDelete": "cascade"}),
+  label: text("label").notNull().default(""),
+  url: text("url").notNull().default(""),
+  resourceType: text("resource_type").notNull().default("link"),
+  externalId: text("external_id"),
+  metadataJson: text("metadata_json"),
+  createdAt: text("created_at").notNull(),
+  updatedAt: text("updated_at").notNull(),
+}, (t) => [
+  index("idx_work_task_resources_task").on(t.taskId)
+]);
+
+export const work_source_aliases = sqliteTable("work_source_aliases", {
+  sourceName: text("source_name").notNull(),
+  sourceRecordId: text("source_record_id").notNull(),
+  canonicalTaskId: text("canonical_task_id").notNull().references((): AnySQLiteColumn => work_tasks.id, {"onUpdate": "cascade", "onDelete": "cascade"}),
+  sourceStatus: text("source_status"),
+  sourceRevision: text("source_revision"),
+  sourceTitleHash: text("source_title_hash"),
+  lastSeenAt: text("last_seen_at").notNull(),
+}, (t) => [
+  primaryKey({columns:[t.sourceName,t.sourceRecordId]}),
+  index("idx_work_source_aliases_task").on(t.canonicalTaskId)
+]);
+
+export const work_calendar_links = sqliteTable("work_calendar_links", {
+  id: text("id").primaryKey(),
+  taskId: text("task_id").references((): AnySQLiteColumn => work_tasks.id, {"onUpdate": "cascade", "onDelete": "set null"}),
+  projectId: text("project_id").references((): AnySQLiteColumn => work_projects.id, {"onUpdate": "cascade", "onDelete": "set null"}),
+  provider: text("provider").notNull().default("google_calendar"),
+  calendarId: text("calendar_id").notNull(),
+  externalEventId: text("external_event_id").notNull(),
+  externalEtag: text("external_etag"),
+  syncStatus: text("sync_status").notNull().default("linked"),
+  lastSyncedAt: text("last_synced_at"),
+  lastChangeSource: text("last_change_source"),
+  providerUpdatedAt: text("provider_updated_at"),
+  revision: integer("revision").notNull().default(1),
+  createdAt: text("created_at").notNull(),
+  updatedAt: text("updated_at").notNull(),
+}, (t) => [
+  uniqueIndex("idx_work_calendar_links_external_identity").on(t.provider,t.calendarId,t.externalEventId)
+]);
+
+export const work_changes = sqliteTable("work_changes", {
+  id: text("id").primaryKey(),
+  entityType: text("entity_type").notNull(),
+  entityId: text("entity_id").notNull(),
+  action: text("action").notNull(),
+  beforeJson: text("before_json"),
+  afterJson: text("after_json"),
+  sourceApp: text("source_app").notNull(),
+  sourceRevision: text("source_revision"),
+  entityRevision: integer("entity_revision").notNull(),
+  idempotencyKey: text("idempotency_key"),
+  createdAt: text("created_at").notNull(),
+}, (t) => [
+  index("idx_work_changes_entity").on(t.entityType,t.entityId,t.createdAt),
+  uniqueIndex("idx_work_changes_idempotency").on(t.idempotencyKey).where(sql`idempotency_key IS NOT NULL`)
+]);
