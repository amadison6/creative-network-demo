+import { env } from "cloudflare:workers";
+import workWorker from "../../../../shared-backend/worker/src/index.js";
+
+export const dynamic = "force-dynamic";
+
+// This route reuses the Site's existing DB. It has no operational task writes,
+// Calendar mutation, file-byte storage, or cutover endpoint.
+async function handle(request: Request) {
+  const url = new URL(request.url);
+  url.pathname = url.pathname.slice("/api/work".length) || "/";
+  return workWorker.fetch(new Request(url, request), env);
+}
+
+export const GET = handle;
+export const POST = handle;
