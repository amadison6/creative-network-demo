name = "network-hq-shared-work"
main = "src/index.js"
compatibility_date = "2026-10-01"

# Copy this file to wrangler.toml only in the deployment environment.
# Bind DB to the EXISTING Network HQ D1 database. Do not create a second
# permanent database for Work.
[[d1_databases]]
binding = "DB"
database_name = "<existing-network-hq-d1-database-name>"
database_id = "<existing-network-hq-d1-database-id>"

# Set WORK_API_TOKEN as a Worker secret. Never commit the value:
#   npx wrangler secret put WORK_API_TOKEN
#
# Apply the additive schema before staging a migration:
#   npx wrangler d1 execute <existing-network-hq-d1-database-name> \
#     --file=../schema/001_work_layer.sql --remote
